# Copy to .env.oral; both entry points load it and share the same patient and database.
ORAL_MEMORY_PATIENT_ID=patient_001
ORAL_MEMORY_ENCOUNTER_ID=current
# Use an absolute path outside the repository for persistent patient data.
# ORAL_MEMORY_DB=/absolute/private/path/oral-memory.sqlite3
ORAL_MEMORY_PYTHON=python3
# Dedicated Harness profiles keep this deployment separate from coding sessions.
# ORAL_HARNESS_HOME=/absolute/private/path/dsh-oral
ORAL_DOCTOR_PORT=8765
# Set your own local doctor credential, at least 16 characters.
ORAL_DOCTOR_TOKEN=
# Existing Harness provider configuration remains available.
# DEEPSEEK_API_KEY=
