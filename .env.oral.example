# Copy to .env.oral; both entry points load it and share the same patient and database.
ORAL_MEMORY_PATIENT_ID=patient_001
ORAL_MEMORY_ENCOUNTER_ID=current
# Use an absolute path outside the repository for persistent patient data.
# ORAL_MEMORY_DB=/absolute/private/path/oral-memory.sqlite3
ORAL_MEMORY_PYTHON=python3
# Dedicated Harness profiles keep this deployment separate from coding sessions.
# ORAL_HARNESS_HOME=/absolute/private/path/dsh-oral
ORAL_DOCTOR_PORT=8765
# Set your own local doctor credential, at least 16 characters.
ORAL_DOCTOR_TOKEN=
# Existing Harness provider configuration remains available.
# DEEPSEEK_API_KEY=

# Shared case library and image vault: use the SAME absolute locations for all patients.
# Neither is exposed to the browser as a filesystem path.
# MEDICAL_SHARED_DB=/absolute/private/path/shared-cases.sqlite3
# MEDICAL_ASSET_ROOT=/absolute/private/path/medical-images
MEDICAL_DOMAIN=oral-leukoplakia
# Add diseases by extending this JSON; models remain frozen.
# MEDICAL_PROFILES=/absolute/path/diseases.json
# All five roles inherit the selected Harness model route, which MUST declare image input.

# Initial retrieval candidates per key; Key2 reranks the deduplicated union, then selects Top-K.
MEDICAL_CANDIDATE_LIMIT=12
MEDICAL_TOP_K=5
# Persistent iteration score starts at 1; each confirmed ineffective event subtracts 0.1.
ORAL_MEMORY_DECAY_STEP=0.1
ORAL_MEMORY_DECAY_FLOOR=0

# Batch: an image-capable OpenAI-compatible endpoint (e.g. Qwen3-VL via vLLM).
ORAL_BATCH_PROVIDER=oral-vlm
ORAL_BATCH_BASE_URL=http://127.0.0.1:8000/v1
ORAL_BATCH_MODEL=Qwen3-VL-8B-Instruct
ORAL_BATCH_API_KEY=
