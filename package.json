{
  "name": "@deepseek-ai/dsh-root",
  "version": "0.2.2-rc.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/system",
    "native/system/packages/*",
    "apps/*",
    "website"
  ],
  "scripts": {
    "build": "node --import tsx/esm scripts/build.ts --scope artifacts",
    "build:artifacts": "node --import tsx/esm scripts/build.ts --scope artifacts",
    "build:check": "node --import tsx/esm scripts/build.ts --scope check",
    "build:official": "node --import tsx/esm scripts/build.ts --profile official",
    "build:lib": "pnpm run build:lib:host && pnpm run build:lib:client",
    "build:lib:host": "node --import tsx/esm scripts/compile-referenced-projects.ts host-libraries && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.host.json && pnpm --filter @deepseek-ai/dsh-desktop run bundle",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --config-loader native --env.DSH_BUILD_FACE client",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "build:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run build",
    "dev:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run dev",
    "start:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run start",
    "build:native-system": "node --import tsx/esm native/system/scripts/build.ts --host-addon-only",
    "clean": "node --import tsx/esm scripts/clean.ts",
    "typecheck": "node --import tsx/esm scripts/build.ts --scope typecheck",
    "typecheck:contracts-ready": "tsc -b tsconfig.client.json",
    "lint": "node --import tsx/esm scripts/compile-referenced-projects.ts host-contracts && npm run lint:contracts-ready",
    "lint:contracts-ready": "node --import tsx/esm scripts/run-oxlint.ts .",
    "lint:fix": "node --import tsx/esm scripts/compile-referenced-projects.ts host-contracts && npm run lint:fix:contracts-ready",
    "lint:fix:contracts-ready": "node --import tsx/esm scripts/run-oxlint.ts --config .oxlintrc.staged.json packages/typert/generator/tests/fixtures/type-model --fix && node --import tsx/esm scripts/run-oxlint.ts . --fix",
    "duplication": "jscpd --config .jscpd.json packages scripts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:expected": "vitest run --config vitest.expected.config.ts",
    "test:expected:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.expected.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:record": "DSH_SNAPSHOT=record vitest run --config vitest.snapshot.config.ts --update",
    "test:snapshot:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.snapshot.config.ts",
    "test:web": "npm run build && npm run test:web:built",
    "test:web:built": "vitest run --config vitest.web.config.ts",
    "test:web:refresh": "npm run build && DSH_SNAPSHOT=refresh vitest run --config vitest.web.config.ts",
    "test:web:ci": "node --import tsx/esm scripts/run-web-snapshots.ts",
    "test:web:perf": "npm run build && npm run test:web:perf:built",
    "test:web:perf:built": "DSH_SNAPSHOT=replay vitest run --config vitest.web.perf.config.ts",
    "test:web:stress": "npm run build && vitest run --config vitest.web-stress.config.ts",
    "test:gui": "vitest run packages/client packages/host",
    "test:bench": "npm run build:bench && npm run build:web && npm run test:bench:built",
    "test:bench:built": "node --import tsx/esm scripts/run-bench-suite.ts",
    "test:bench:memory": "node --import tsx/esm scripts/run-memory-pressure-bench.ts",
    "build:bench": "npm run build:native-system && npm run build:lib && tsdown --config-loader native --config benchmarks/tsdown.config.ts",
    "dsh": "node --import tsx/esm apps/cli/src/bin.ts",
    "start:web": "node --import tsx/esm apps/cli/src/bin.ts web",
    "dev:web": "node --import tsx/esm scripts/dev-web.ts --poll",
    "gen-tsconfig-paths": "node --import tsx/esm scripts/gen-tsconfig-paths.ts",
    "verify-tsconfig-paths": "node --import tsx/esm scripts/gen-tsconfig-paths.ts --check",
    "migrate:sessions-to-v4": "node --import tsx/esm scripts/migrate-sessions-to-v4.ts",
    "migrate:packed-session-fixtures": "node --import tsx/esm scripts/migrate-packed-session-fixtures.ts",
    "test": "pnpm run test:oral",
    "test:oral": "node scripts/oral-project.mjs test",
    "test:framework": "vitest run packages/core/system-prompt/tests packages/preset/persona/tests packages/mcp/mcp-client/tests",
    "oral:patient": "node scripts/oral-project.mjs patient",
    "oral:doctor": "node scripts/oral-project.mjs doctor",
    "oral:check": "node scripts/oral-project.mjs check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-ptc": "workspace:*",
    "@deepseek-ai/dsh-tool-terminal": "workspace:*",
    "@deepseek-ai/dsh-terminal-panel": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-llm-replay": "workspace:*",
    "@deepseek-ai/dsh-subagent-dsh-sdk": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@yao-pkg/pkg": "6.21.0",
    "@yarnpkg/cli-dist": "4.18.0",
    "diff": "^9.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "execa": "^10.0.1",
    "zod": "4.6.6",
    "extract-zip": "^2.0.1",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.2",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.3.2",
    "jscpd": "^5.1.2",
    "jsdom": "29.1.1",
    "lefthook": "^2.1.12",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "papaparse": "5.5.3",
    "pnpm": "11.28.5",
    "publint": "^0.3.24",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "spdx-expression-parse": "^5.0.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/dsh-tool-working-directory": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*",
    "@deepseek-ai/dsh-timeline": "workspace:*"
  }
}
