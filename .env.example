# 可不配置模型，直接运行逐项问询与医生工作台。
# 需要自然语言提取和回答时，复制本文件为 .env 并填写 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ORAL_MODEL=deepseek-chat

# 每个运行实例绑定一个患者；切换患者需修改后重启。
ORAL_MEMORY_PATIENT_ID=patient_001
# 可选：已有 SQLite 数据库的绝对路径。留空行请删除，不要设为空值。
# ORAL_MEMORY_DB=/absolute/path/oral-memory.sqlite3
# 可选：至少 16 位。未配置时首次启动生成到 data/doctor-token.txt。
# ORAL_DOCTOR_TOKEN=
